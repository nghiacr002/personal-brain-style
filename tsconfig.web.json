{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "web",
    "outDir": "public",
    "removeComments": true,
    "noEmitOnError": true
  },
  "include": [
    "web/**/*.ts"
  ]
}
