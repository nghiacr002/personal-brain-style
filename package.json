{
  "name": "personal-brain-style",
  "version": "1.3.0-beta.4",
  "type": "module",
  "description": "Your working preferences, applied consistently across AI tools. Local preference studio with discovery and MCP integrations.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node scripts/run.mjs scripts/dev.mjs",
    "mcp": "node scripts/run.mjs src/cli.ts mcp",
    "cli": "node scripts/run.mjs src/cli.ts",
    "test": "node scripts/run.mjs --test tests/*.test.ts tests/*.test.mjs",
    "build:ui": "tsc --project tsconfig.web.json",
    "doctor": "node scripts/run.mjs src/cli.ts doctor",
    "seed": "node scripts/run.mjs src/cli.ts seed",
    "check:node": "node scripts/run.mjs --check",
    "start:stable": "node scripts/run.mjs src/cli.ts serve",
    "build:package": "npm run build:ui && node scripts/build-package.mjs",
    "prepack": "npm run build:package",
    "test:quality": "node scripts/run.mjs --test tests/instruction-quality.test.ts",
    "format": "prettier --write \"**/*.{ts,mjs,js}\"",
    "format:check": "prettier --check \"**/*.{ts,mjs,js}\"",
    "lint": "eslint .",
    "typecheck": "tsc --project tsconfig.json && tsc --project tsconfig.web.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.72.1"
  },
  "bin": {
    "personal-brain": "dist/scripts/personal-brain.mjs"
  },
  "files": [
    "dist/",
    "docs/CHATGPT.md",
    "docs/FUSION-AND-INSTRUCTIONS.md",
    "docs/PLATFORM-SUPPORT.md"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "coding-agent",
    "codex",
    "claude-code",
    "chatgpt",
    "agent-instructions",
    "agent-skills",
    "prompt-management",
    "project-styles",
    "local-first",
    "fusion"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nghiacr002/personal-brain-style.git"
  },
  "homepage": "https://github.com/nghiacr002/personal-brain-style#readme",
  "bugs": {
    "url": "https://github.com/nghiacr002/personal-brain-style/issues"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "bundledDependencies": [
    "yaml"
  ],
  "bundleDependencies": [
    "yaml"
  ]
}
